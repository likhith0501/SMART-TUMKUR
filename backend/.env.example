# Environment Variables Configuration
# Smart Civic - Tumakuru (Backend / FastAPI on Render)

# Application Environment
ENV=production
DEBUG=False
PORT=8000
HOST=0.0.0.0

# Supabase (Database + Storage)
# Project Settings -> API in the Supabase dashboard.
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
# Use the service_role key (server-side only). Never expose it to the frontend.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Public base URL of this backend (used to build absolute upload URLs in local mode).
# On Render this is optional; set it to your service URL, e.g. https://smart-civic-api.onrender.com
PUBLIC_BASE_URL=http://localhost:8000

# Comma-separated list of allowed frontend origins (Vercel).
# Use * to allow all (fine for a college project / demo).
CORS_ORIGINS=*

# JWT Cryptographic Secret (change this in production)
JWT_SECRET=tumakuru_smart_civic_super_secret_jwt_key_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Admin Initial Seed Account
INITIAL_ADMIN_USERNAME=likhi
INITIAL_ADMIN_PASSWORD=likhi@2005

# Storage (local fallback only; Supabase Storage is used when SUPABASE_* is set)
UPLOAD_DIR=./uploads